{
  "name": "jorkaring-cms",
  "version": "1.0.0",
  "description": "Payload CMS for jorkaring",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "payload generate:importmap && next build",
    "start": "payload migrate && next start",
    "migrate": "payload migrate",
    "generate:types": "payload generate:types",
    "generate:graphQLSchema": "payload generate:graphQLSchema",
    "generate:importmap": "payload generate:importmap",
    "export:content": "npx tsx scripts/export-content.ts",
    "restore:content": "npx tsx scripts/restore-content.ts",
    "list:backups": "ls -la backups/ 2>/dev/null || echo 'No backups directory'"
  },
  "dependencies": {
    "@lexical/selection": "^0.35.0",
    "lexical": "^0.35.0",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "graphql": "^16.9.0",
    "next": "^15.0.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}