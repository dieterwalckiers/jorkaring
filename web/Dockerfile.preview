FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9 --activate

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Build the application in SSR mode
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NODE_ENV=production

# Pass runtime config as build args so Nuxt bakes them into the build
ARG NUXT_PAYLOAD_API_URL
ARG NUXT_PUBLIC_PAYLOAD_API_URL
ARG NUXT_PUBLIC_PAYLOAD_SERVER_URL
ARG NUXT_PUBLIC_PREVIEW_MODE
ARG PAYLOAD_API_URL

# Make them available as env vars during build
ENV NUXT_PAYLOAD_API_URL=${NUXT_PAYLOAD_API_URL}
ENV NUXT_PUBLIC_PAYLOAD_API_URL=${NUXT_PUBLIC_PAYLOAD_API_URL}
ENV NUXT_PUBLIC_PAYLOAD_SERVER_URL=${NUXT_PUBLIC_PAYLOAD_SERVER_URL}
ENV NUXT_PUBLIC_PREVIEW_MODE=${NUXT_PUBLIC_PREVIEW_MODE}
ENV PAYLOAD_API_URL=${PAYLOAD_API_URL}

RUN pnpm run build

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nuxtjs

# Copy only the Nuxt server output
COPY --from=builder /app/.output ./.output

USER nuxtjs

# Railway sets PORT dynamically
ENV PORT=3000
ENV HOST=0.0.0.0

EXPOSE 3000

CMD ["sh", "-c", "node .output/server/index.mjs"]
