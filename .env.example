# Payload CMS
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload
PAYLOAD_SECRET=your-secret-key-here
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3202

# GitHub webhook (for auto-deploy on content changes)
GITHUB_TOKEN=your-github-token
GITHUB_REPO=owner/repo

# Frontend
NUXT_PUBLIC_PAYLOAD_API_URL=http://localhost:3202/api
NUXT_PUBLIC_PAYLOAD_SERVER_URL=http://localhost:3202

# Live Preview
# PREVIEW_URL: URL of the Nuxt preview server that Payload loads in its admin iframe
#   Local dev: http://localhost:3201 | Production: the web-preview service URL
# Set PREVIEW_URL on the Payload service, and NUXT_PUBLIC_PAYLOAD_* on the preview service
PREVIEW_URL=http://localhost:3201
# Set to 'true' on the preview SSR server so API calls include draft content
NUXT_PUBLIC_PREVIEW_MODE=false

# Media storage (Neon Object Storage via @payloadcms/storage-s3)
# Leave S3_BUCKET unset locally to store uploads in payload/public/uploads.
# Values come from `neon env pull` (AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_* keys).
S3_BUCKET=
S3_ENDPOINT=https://<branch-id>.storage.<cell>.eu-central-1.aws.neon.tech
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
